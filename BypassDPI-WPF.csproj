<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BypassDPI-WPF</AssemblyName>
    <RootNamespace>NetFix</RootNamespace>
    <Platforms>x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RollForward>LatestMajor</RollForward>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <Copyright>© 2024-2026 rupleide</Copyright>
    <Product>BypassDPI-WPF</Product>
    <Description>GUI-оболочка для обхода блокировок Telegram и Discord (неофициальный форк)</Description>
    <License>GPL-3.0-only</License>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Backup_18.03.2026_ 0-05\**" />
    <Page Remove="Backup_18.03.2026_ 0-05\**" />
    <None Remove="Backup_18.03.2026_ 0-05\**" />
    <EmbeddedResource Remove="Backup_18.03.2026_ 0-05\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\noise.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\noise.png" />
  </ItemGroup>

<ItemGroup>
    <EmbeddedResource Include="Assets\Fallback\zapret-fallback.zip" Condition="Exists('Assets\Fallback\zapret-fallback.zip')" />
    <EmbeddedResource Include="Assets\Fallback\tgwsproxy-fallback.exe" Condition="Exists('Assets\Fallback\tgwsproxy-fallback.exe')" />
    <EmbeddedResource Include="Assets\Fallback\metadata.json" Condition="Exists('Assets\Fallback\metadata.json')" />
  </ItemGroup>
</Project>
